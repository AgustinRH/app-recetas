# API
PORT=3000
NODE_ENV=development

# postgres | sqlite  (sqlite is for local demo without Docker)
DB_TYPE=postgres
DATABASE_URL=postgres://dishtoday:REDACTED@localhost:5432/dishtoday
DB_SYNC=true
SQLITE_PATH=dev.sqlite

# Set true to accept Authorization: Bearer dev:email@example.com
DEV_AUTH=true

# Comma-separated emails that see the in-app admin section
ADMIN_EMAILS=
SEED_ON_START=true

# Firebase Admin (omit when using DEV_AUTH only)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Redis (optional — feed cache disabled if empty)
REDIS_URL=redis://localhost:6379

# Typesense (optional — SQL fallback if empty)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# MinIO / S3 (optional — local ./uploads if empty)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=REDACTED
MINIO_BUCKET=dishtoday
PUBLIC_BASE_URL=http://localhost:3000
