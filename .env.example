# Local API / Flutter development (outside Docker Compose).
# For production Compose secrets, use infra/.env.example → infra/.env

PORT=3000
NODE_ENV=development

DB_TYPE=postgres
DATABASE_URL=postgres://dishtoday:change-me@localhost:5432/dishtoday
DB_SYNC=true
SQLITE_PATH=dev.sqlite

DEV_AUTH=true
ADMIN_EMAILS=
SEED_ON_START=true

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

REDIS_URL=redis://localhost:6379

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change-me-typesense-key

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=dishtoday
PUBLIC_BASE_URL=http://localhost:3000
