# Copy to infra/.env and fill in real values. Never commit .env.

POSTGRES_USER=dishtoday
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dishtoday
# Inside Compose the DB host is the service name `postgres`
DATABASE_URL=postgres://dishtoday:change-me@postgres:5432/dishtoday

TYPESENSE_API_KEY=change-me-typesense-key
PUBLIC_BASE_URL=https://api.example.com

NODE_ENV=production
DB_SYNC=false
SEED_ON_START=false
DEV_AUTH=false
ADMIN_EMAILS=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=dishtoday
